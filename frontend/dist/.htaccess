# SPA React — el dominio de la agenda es ritualnails.store (Apache / cPanel)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS: sin esto el origen http:// choca con CORS del API en Render.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # El dominio anterior conserva la ruta (/admin/, /m/..., consulta y ancla).
  RewriteCond %{HTTP_HOST} ^(www\.)?agenda\.nuncajamasropa\.com$ [NC]
  RewriteRule ^ https://ritualnails.store%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.ritualnails\.store$ [NC]
  RewriteRule ^ https://ritualnails.store%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # Si falta un asset, 404 real (no index.html). Evita que la CDN cachee
  # text/html en URLs .js y rompa el MIME type del navegador.
  RewriteRule ^assets/ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
